# GovConnect ops scheduler environment — copy to /etc/govconnect/scheduler.env
# (mode 600, owned by root). NEVER commit the real file.
#
# Internal API key of ai-service (sent as x-internal-api-key header).
INTERNAL_API_KEY=change-me

# Base URL of ai-service as seen from this host.
AI_SERVICE_URL=http://127.0.0.1:3002

# Space-separated village ids for per-village jobs (kb-suggest, canary-rotate).
# Keep in sync with onboarded villages.
VILLAGE_IDS=
