NODE_ENV=development
PORT=3002

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/govconnect?schema=ai

RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/govconnect
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672

CHANNEL_SERVICE_URL=http://127.0.0.1:3001
CASE_SERVICE_URL=http://127.0.0.1:3003
DASHBOARD_SERVICE_URL=http://127.0.0.1:3010

INTERNAL_API_KEY=change-me-internal-api-key-ess
PROFILE_ENCRYPTION_KEY=change-me-32-byte-hex-key
ALLOWED_ORIGINS=http://localhost:3010,http://127.0.0.1:3010,http://localhost:3011,http://127.0.0.1:3011

RAG_RETRIEVAL_MODE=heuristic_rerank
RAG_LLM_RERANK_MAX_CANDIDATES=12
RAG_ENABLE_RETRIEVAL_CACHE=true
RAG_RETRIEVAL_CACHE_TTL_SECONDS=300

EMBEDDING_RETRY_COUNT=3
EMBEDDING_RETRY_BASE_MS=500
EMBEDDING_RETRY_MAX_MS=5000

BATCH_DELAY_MS=3000
WEBCHAT_BATCH_DELAY_MS=3000
MAX_BATCH_SIZE=5

S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_PATH_STYLE=false
S3_PUBLIC_URL=https://cdn.example.com
S3_RETENTION_DAYS=365
S3_MEDIA_DELIVERY=s3

PUBLIC_BASE_URL=http://localhost:3010
PUBLIC_FORM_BASE_URL=http://localhost:3010

LOG_LEVEL=debug
LOG_DIR=logs

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=3000
TESTING_MODE=false
MAX_HISTORY_MESSAGES=30

SPAM_GUARD_ENABLED=true
SPAM_GUARD_MAX_IDENTICAL=5
SPAM_GUARD_BAN_DURATION_MS=60000
SPAM_RATE_MAX_MESSAGES=10
SPAM_RATE_WINDOW_MS=10000

RATE_LIMIT_ENABLED=true
MAX_REPORTS_PER_DAY=5
COOLDOWN_SECONDS=30
AUTO_BLACKLIST_VIOLATIONS=10

GOLDEN_SET_THRESHOLD_OVERALL=0.75
GOLDEN_SET_THRESHOLD_INTENT=0.75
GOLDEN_SET_THRESHOLD_KEYWORD=0.70
GOLDEN_SET_THRESHOLD_TOOL=0.70
GOLDEN_SET_REGRESSION_DELTA=0.05
