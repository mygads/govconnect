# ==================== AI ORCHESTRATOR SERVICE ====================
#
# ENVIRONMENT MODES:
# ┌──────────────────────────────────────────────────────────────────────────┐
# │  MODE              │ SERVICE_URL PATTERN         │ RABBITMQ HOST         │
# ├──────────────────────────────────────────────────────────────────────────┤
# │  Local Dev (npm)   │ http://localhost:PORT       │ localhost:5672        │
# │  Docker Compose    │ http://service-name:PORT    │ rabbitmq:5672         │
# │  Docker Swarm      │ http://service-name:PORT    │ rabbitmq:5672         │
# └──────────────────────────────────────────────────────────────────────────┘
#
# IMPORTANT: This service is STATELESS (no database) and communicates via:
# - RabbitMQ: Consume incoming messages, publish AI replies
# - REST: Sync calls to Channel/Case services for data
# ============================================================================

# Environment
NODE_ENV=development
PORT=3002

# ==================== AI GATEWAY LANES ====================
# 4 explicit lanes — each lane must declare its own PROVIDER, API_KEY, BASE_URL, MODEL.
# If a lane is incomplete, that lane is disabled.
# Provider values:
# - openrouter
# - sumopod
# - vercel
# - cloudflare
# - direct
#
# Default recommendation:
# - use OpenRouter for all 4 lanes first
# - switch per lane later if needed

# Lane 1: LLM (main chat completions)
LLM_PROVIDER=openrouter
LLM_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_MS=30000
LLM_CHAT_COMPLETIONS_PATH=/chat/completions

# Lane 2: Embed (vector embeddings)
EMBED_PROVIDER=openrouter
EMBED_API_KEY=your_openrouter_api_key_here
EMBED_BASE_URL=https://openrouter.ai/api/v1
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIMENSIONS=768
EMBED_TIMEOUT_MS=30000
EMBED_EMBEDDINGS_PATH=/embeddings

# Lane 3: RAG (query rewrite before retrieval)
RAG_PROVIDER=openrouter
RAG_API_KEY=your_openrouter_api_key_here
RAG_BASE_URL=https://openrouter.ai/api/v1
RAG_REWRITE_MODEL=openai/gpt-4o-mini
RAG_QUERY_REWRITE_TIMEOUT_MS=10000
RAG_CHAT_COMPLETIONS_PATH=/chat/completions

# Lane 4: Rerank (post-retrieval scoring)
RERANK_PROVIDER=openrouter
RERANK_API_KEY=your_openrouter_api_key_here
RERANK_BASE_URL=https://openrouter.ai/api/v1
RERANK_MODEL=cohere/rerank-v3.5
RERANK_ENABLED=true
RERANK_TIMEOUT_MS=30000
RERANK_PATH=/rerank
RERANK_TOP_N=5

# Optional extra headers per lane (JSON object string)
LLM_DEFAULT_HEADERS_JSON=
EMBED_DEFAULT_HEADERS_JSON=
RAG_DEFAULT_HEADERS_JSON=
RERANK_DEFAULT_HEADERS_JSON=

# Optional OpenRouter-specific settings
OPENROUTER_SITE_URL=https://govconnect.my.id
OPENROUTER_APP_NAME=GovConnect AI Service
# Upstream provider routing inside OpenRouter (optional)
OPENROUTER_PROVIDER_ORDER=
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_REQUIRE_PARAMETERS=false
OPENROUTER_ZDR_ONLY=false

# RAG lane behavior
RAG_LLM_RERANK_MAX_CANDIDATES=12
RAG_ENABLE_RETRIEVAL_CACHE=true
RAG_RETRIEVAL_CACHE_TTL_SECONDS=300

# ==================== DATABASE ====================
# PostgreSQL with pgvector extension for AI Service
# Uses separate database gc_ai (no schema needed, uses public by default)
# Local Dev: localhost:5432 (mapped port)
# Docker: infra-postgres:5432
DATABASE_URL=postgresql://user:password@infra-postgres:5432/govconnect?schema=ai

# RabbitMQ
# Local Dev: localhost:5672
# Docker: rabbitmq:5672
RABBITMQ_URL=amqp://admin:genfityrabbitmq@rabbitmq:5672/govconnect

# ==================== INTERNAL SERVICE URLS ====================
# These are for internal service-to-service communication
# In Docker (Compose/Swarm): Use container names (channel-service, case-service)
# In Local Dev: Use localhost with respective ports
#
# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  LOCAL DEVELOPMENT (npm run dev)                                            │
# │  ─────────────────────────────────────────────────────────────────────────  │
# │  CHANNEL_SERVICE_URL=http://localhost:3001                                  │
# │  CASE_SERVICE_URL=http://localhost:3003                                     │
# │  DASHBOARD_SERVICE_URL=http://localhost:3000                                │
# ├─────────────────────────────────────────────────────────────────────────────┤
# │  DOCKER (Compose/Swarm) - Uses internal Docker network                      │
# │  ─────────────────────────────────────────────────────────────────────────  │
# │  CHANNEL_SERVICE_URL=http://channel-service:3001                            │
# │  CASE_SERVICE_URL=http://case-service:3003                                  │
# │  DASHBOARD_SERVICE_URL=http://dashboard:3000                                │
# └─────────────────────────────────────────────────────────────────────────────┘
#
CHANNEL_SERVICE_URL=http://channel-service:3001
CASE_SERVICE_URL=http://case-service:3003
DASHBOARD_SERVICE_URL=http://dashboard:3000

# Internal API Key (shared secret for inter-service authentication)
# All services must use the same key for internal calls
INTERNAL_API_KEY=govconnect-internal-2025-secret

# ==================== S3 / OBJECT STORAGE ====================
# Knowledge documents sekarang disimpan di object storage S3-compatible.
# Untuk Cloudflare R2 via S3 API, gunakan region `auto`.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=govconnect-media
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_PATH_STYLE=false
S3_PUBLIC_URL=https://cdn.govconnect.my.id
S3_RETENTION_DAYS=365
S3_MEDIA_DELIVERY=s3

# Encryption key for PII data (AES-256-GCM) — enkripsi profil warga
# Generate: openssl rand -hex 32
# Wajib diisi untuk local Docker Compose dan production. Jika kosong, service
# akan berhenti saat NODE_ENV=production.
PROFILE_ENCRYPTION_KEY=
ALLOWED_ORIGINS=http://localhost:3011,http://127.0.0.1:3011,http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=debug
LOG_DIR=logs

# LLM Configuration
# Note:
# - Konfigurasi model AI hanya melalui ENV (tidak ada pengaturan di dashboard)
# - Token cost untuk model gateway bisa dioverride via AI_MODEL_PRICING_OVERRIDES JSON
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000
AI_MODEL_PRICING_OVERRIDES=

# ==================== TESTING MODE ====================
# Enable testing mode to skip WhatsApp API calls (true/false)
# When enabled: messages processed but not sent to WhatsApp
# Useful for development and testing without affecting real users
TESTING_MODE=false

# Context Configuration
MAX_HISTORY_MESSAGES=30

# ==================== SPAM GUARD ====================
# Proteksi spam: config untuk AI-side bubble superseding
SPAM_GUARD_MAX_IDENTICAL=5
SPAM_GUARD_BAN_DURATION_MS=60000
SPAM_RATE_MAX_MESSAGES=10
SPAM_RATE_WINDOW_MS=10000

# ==================== RATE LIMITING ====================
# Enable/disable rate limiting (true/false)
RATE_LIMIT_ENABLED=true
# Maximum reports per day per user
MAX_REPORTS_PER_DAY=5
# Cooldown between reports in seconds
COOLDOWN_SECONDS=30
# Auto-blacklist after N violations
AUTO_BLACKLIST_VIOLATIONS=10

# ==================== GOLDEN SET THRESHOLDS ====================
# Optional: quality thresholds for regression detection
GOLDEN_SET_THRESHOLD_OVERALL=0.75
GOLDEN_SET_THRESHOLD_INTENT=0.75
GOLDEN_SET_THRESHOLD_KEYWORD=0.70
GOLDEN_SET_REGRESSION_DELTA=0.05
