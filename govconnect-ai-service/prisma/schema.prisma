// Prisma schema for AI Service Vector Database
// Handles all vector storage and semantic search operations

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ==================== KNOWLEDGE VECTORS ====================
// Stores embeddings for knowledge base items
// Source of truth for vector search on knowledge

model knowledge_vectors {
  id                String   @id // Same ID as dashboard.knowledge_base
  village_id         String?
  title             String
  content           String   @db.Text
  category          String
  keywords          String[]
  
  // Vector embedding
  embedding         Unsupported("vector(768)")
  embedding_model   String   @default("openai/text-embedding-3-small")
  
  // Quality metrics (synced from dashboard or computed here)
  quality_score     Float    @default(1.0)
  usage_count       Int      @default(0)
  retrieval_count   Int      @default(0)
  last_retrieved    DateTime?
  
  // Timestamps
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  
  @@index([category])
  @@index([village_id])
  @@index([quality_score])
}

// ==================== DOCUMENT VECTORS ====================
// Stores embeddings for document chunks
// Each document can have multiple chunks

model document_vectors {
  id                String   @id @default(cuid())
  document_id       String   // Reference to dashboard.knowledge_documents
  village_id         String?
  chunk_index       Int
  content           String   @db.Text
  
  // Document metadata (denormalized for search)
  document_title    String?
  category          String?
  page_number       Int?
  section_title     String?
  
  // Vector embedding
  embedding         Unsupported("vector(768)")
  embedding_model   String   @default("openai/text-embedding-3-small")
  
  // Timestamps
  created_at        DateTime @default(now())
  
  @@unique([document_id, chunk_index])
  @@index([document_id])
  @@index([village_id])
  @@index([category])
}

// ==================== EMBEDDING JOBS ====================
// Track embedding generation jobs for async processing

model embedding_jobs {
  id            String   @id @default(cuid())
  type          String   // "knowledge" | "document"
  target_id     String   // ID of knowledge/document
  status        String   @default("pending") // pending, processing, completed, failed
  error_message String?  @db.Text
  retry_count   Int      @default(0)
  priority      Int      @default(0)
  
  created_at    DateTime @default(now())
  started_at    DateTime?
  completed_at  DateTime?
  
  @@index([status])
  @@index([priority])
}

// ==================== QUESTION VARIANTS ====================
// AI-generated question variants per knowledge base entry
// Stored as additional vectors to improve recall for diverse phrasings

model question_variants {
  id                String   @id @default(cuid())
  source_id         String   // ID of parent knowledge_vectors entry
  source_type       String   @default("knowledge") // "knowledge" | "document_chunk"
  village_id        String?
  variant_text      String   @db.Text
  
  // Vector embedding of the variant question
  embedding         Unsupported("vector(768)")
  embedding_model   String   @default("openai/text-embedding-3-small")
  
  created_at        DateTime @default(now())
  
  @@index([source_id])
  @@index([village_id])
}

// ==================== AI TOKEN USAGE ====================
// Tracks actual token usage from gateway/provider responses
// Stored per-call for granular analytics

model ai_token_usage {
  id              String   @id @default(cuid())
  
  // Model info
  model           String   // e.g. "openai/gpt-4o-mini", "google/gemini-2.5-flash-lite"
  
  // Token counts (normalized into a common OpenAI-compatible shape)
  input_tokens    Int
  output_tokens   Int
  total_tokens    Int
  
  // Cost in USD (calculated from pricing table)
  cost_usd        Float    @default(0)
  
  // Call classification
  layer_type      String   // "full_nlu" | "micro_nlu" | "embedding" | "rag_expand"
  call_type       String   // "main_chat" | "anti_hallucination_retry" | "complaint_type_match" | "service_slug_match" | "rag_query_expand" | "confirmation_classify" | "farewell_classify" | "greeting_classify" | "embedding_single" | "embedding_batch"
  
  // Tenant & user context
  village_id      String?
  wa_user_id      String?
  session_id      String?  // webchat session or WA user id
  channel         String?  // "whatsapp" | "webchat"
  
  // LLM response context
  intent          String?  // The detected intent (for main_chat calls)
  success         Boolean  @default(true)
  duration_ms     Int?     // How long the LLM call took
  
  // API Key source tracking
  key_source       String?  // "gateway_<lane>" or legacy older values
  key_id           String?  // gateway key label or legacy identifier
  key_tier         String?  // gateway provider or legacy tier label

  // DB-backed provider/model and billing metadata
  provider_id      String?
  model_config_id  String?
  lane_type        String?
  actual_cost_usd  Float    @default(0)
  adjusted_cost_usd Float   @default(0)
  margin_usd       Float    @default(0)

  created_at      DateTime @default(now())

  @@index([model])
  @@index([village_id])
  @@index([layer_type])
  @@index([call_type])
  @@index([created_at])
  @@index([village_id, created_at])
  @@index([model, created_at])
  @@index([channel, created_at])
  @@index([key_source])
  @@index([provider_id])
  @@index([model_config_id])
  @@index([lane_type])
}

model ai_village_wallets {
  id                    String    @id @default(cuid())
  village_id            String    @unique
  balance_usd           Float     @default(0)
  warning_threshold_usd Float     @default(1)
  status                String    @default("exhausted")
  last_topup_at         DateTime?
  last_exhausted_at     DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  ledger_entries        ai_wallet_ledger_entries[]

  @@index([status])
  @@index([updated_at])
}

model ai_wallet_ledger_entries {
  id                 String   @id @default(cuid())
  village_id         String
  wallet_id          String
  entry_type         String
  amount_usd         Float
  balance_before_usd Float
  balance_after_usd  Float
  actual_cost_usd    Float    @default(0)
  adjusted_cost_usd  Float    @default(0)
  margin_usd         Float    @default(0)
  reference_type     String?
  reference_id       String?
  metadata_json      Json?
  created_by_admin_id String?
  created_at         DateTime @default(now())

  wallet             ai_village_wallets @relation(fields: [wallet_id], references: [id], onDelete: Cascade)

  @@index([village_id, created_at])
  @@index([wallet_id, created_at])
  @@index([entry_type, created_at])
  @@index([reference_type, reference_id])
}

model ai_topup_vouchers {
  id                      String    @id @default(cuid())
  code                    String    @unique
  amount_usd              Float
  status                  String    @default("active")
  expires_at              DateTime?
  redeemed_by_village_id  String?
  redeemed_by_admin_id    String?
  redeemed_at             DateTime?
  metadata_json           Json?
  created_by_admin_id     String?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  @@index([status])
  @@index([redeemed_by_village_id])
  @@index([created_at])
}

model ai_providers {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  provider_kind        String   @default("openai_compatible")
  base_url             String
  api_key_encrypted    String?  @db.Text
  default_headers_json Json?
  is_active            Boolean  @default(true)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  endpoints            ai_provider_endpoints[]
  models               ai_models[]

  @@index([is_active])
}

model ai_provider_endpoints {
  id            String   @id @default(cuid())
  provider_id   String
  lane_type     String
  endpoint_path String
  is_default    Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  provider      ai_providers @relation(fields: [provider_id], references: [id], onDelete: Cascade)

  @@index([provider_id])
  @@index([lane_type])
  @@unique([provider_id, lane_type, endpoint_path])
}

model ai_models {
  id                                    String   @id @default(cuid())
  provider_id                           String
  lane_type                             String
  display_name                          String
  upstream_model_name                   String
  endpoint_path                         String?
  actual_pricing_type                   String   @default("per_million_tokens")
  actual_fixed_price_usd                Float?
  actual_input_price_per_million_usd    Float?
  actual_output_price_per_million_usd   Float?
  adjusted_pricing_type                 String   @default("per_million_tokens")
  adjusted_fixed_price_usd              Float?
  adjusted_input_price_per_million_usd  Float?
  adjusted_output_price_per_million_usd Float?
  is_active                             Boolean  @default(true)
  is_publicly_selectable                Boolean  @default(true)
  notes                                 String?  @db.Text
  created_at                            DateTime @default(now())
  updated_at                            DateTime @updatedAt

  provider                              ai_providers @relation(fields: [provider_id], references: [id], onDelete: Cascade)
  primary_assignments                   ai_lane_assignments[] @relation("PrimaryModel")
  fallback_assignments                  ai_lane_assignments[] @relation("FallbackModel")

  @@index([provider_id])
  @@index([lane_type])
  @@index([is_active])
  @@unique([provider_id, lane_type, upstream_model_name])
}

model ai_lane_assignments {
  id                String   @id @default(cuid())
  lane_type         String
  primary_model_id  String
  fallback_model_id String?
  village_id        String?
  is_global_default Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  primary_model     ai_models @relation("PrimaryModel", fields: [primary_model_id], references: [id], onDelete: Restrict)
  fallback_model    ai_models? @relation("FallbackModel", fields: [fallback_model_id], references: [id], onDelete: SetNull)

  @@index([lane_type])
  @@index([village_id])
  @@index([is_global_default])
  @@unique([lane_type, village_id, is_global_default])
}

// ==================== CONVERSATION SESSIONS (Temuan 7) ====================
// Persists critical in-memory conversation state to survive restarts
// Fire-and-forget writes — stale data is acceptable, lost data is not

model conversation_sessions {
  id              String   @id @default(cuid())
  wa_user_id      String
  session_key     String   // e.g. "pendingComplaintData", "pendingAddressConfirmation"
  state_json      String   @db.Text // JSON-serialized state
  expires_at      DateTime // Auto-cleanup expired sessions
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([wa_user_id, session_key])
  @@index([wa_user_id])
  @@index([expires_at])
}

// ==================== RATE LIMIT BLACKLIST (Temuan 8) ====================
// Persists rate limiter blacklist entries so they survive service restarts

model rate_limit_blacklist {
  id              String   @id @default(cuid())
  wa_user_id      String   @unique
  reason          String
  blocked_at      DateTime @default(now())
  expires_at      DateTime? // null = permanent
  violation_count Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([wa_user_id])
  @@index([expires_at])
}

// ==================== DURABLE USER PROFILE MEMORY ====================
// Long-term structured memory for reusable user facts/preferences.

model durable_user_profiles {
  wa_user_id              String   @id
  preferred_language      String   @default("auto")
  communication_style     String   @default("auto")
  response_detail         String   @default("auto")
  data_consent            Boolean  @default(false)
  data_consent_at         DateTime?
  data_consent_version    String?
  default_address         String?  @db.Text
  default_rt_rw           String?
  default_kelurahan       String?
  nama_lengkap            String?
  nik                     String?  @db.Text
  no_hp                   String?  @db.Text
  frequent_services       String[]
  total_complaints        Int      @default(0)
  total_service_requests  Int      @default(0)
  first_interaction       DateTime @default(now())
  last_interaction        DateTime @default(now())
  total_messages          Int      @default(0)
  avg_sentiment_score     Float    @default(0)
  frustration_count       Int      @default(0)
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  @@index([last_interaction])
  @@index([updated_at])
}

// ==================== EPISODIC USER MEMORY ====================
// Query-relevant action memory used as the long-term layer in hybrid memory.

model user_memory_entries {
  id                String   @id @default(cuid())
  wa_user_id        String
  village_id        String?
  memory_type       String
  memory_key        String?
  content           String   @db.Text
  metadata_json     Json?
  importance        Float    @default(0.5)
  last_accessed_at  DateTime?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  vector            user_memory_vectors?

  @@index([wa_user_id])
  @@index([wa_user_id, created_at])
  @@index([wa_user_id, memory_type])
  @@index([village_id])
}

// ==================== EPISODIC MEMORY VECTORS ====================
// Semantic retrieval layer for long-term user memory.

model user_memory_vectors {
  id                String   @id @default(cuid())
  memory_entry_id   String   @unique
  wa_user_id        String
  village_id        String?
  memory_type       String
  content           String   @db.Text
  importance        Float    @default(0.5)
  embedding         Unsupported("vector(768)")
  embedding_model   String   @default("openai/text-embedding-3-small")
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  memory_entry      user_memory_entries @relation(fields: [memory_entry_id], references: [id], onDelete: Cascade)

  @@index([wa_user_id])
  @@index([wa_user_id, memory_type])
  @@index([village_id])
}

// ==================== DURABLE AI INTERACTION ANALYTICS ====================
// Stores one row per finalized citizen interaction so dashboards remain usable
// after service restarts and can support tenant-filtered analytics queries.

model ai_interaction_events {
  id                   String   @id @default(cuid())
  analytics_session_id String
  wa_user_id           String
  village_id           String?
  channel              String?
  intent               String
  success              Boolean  @default(true)
  has_knowledge        Boolean  @default(false)
  is_fallback          Boolean  @default(false)
  agent_mode           String?
  response_source      String?
  tools_used_json      Json?
  tool_count           Int      @default(0)
  model                String?
  processing_time_ms   Int?
  created_at           DateTime @default(now())

  @@index([analytics_session_id])
  @@index([wa_user_id, created_at])
  @@index([village_id, created_at])
  @@index([intent, created_at])
  @@index([channel, created_at])
}

// ==================== DURABLE RETRIEVAL OBSERVABILITY ====================
// Stores retrieval traces and candidate-level debug for hybrid search.

model ai_retrieval_traces {
  id                   String   @id @default(cuid())
  trace_id             String?
  wa_user_id           String?
  village_id           String?
  channel              String?
  query                String   @db.Text
  retrieval_mode       String
  confidence           String
  has_knowledge        Boolean  @default(false)
  result_count         Int      @default(0)
  search_time_ms       Int      @default(0)
  top_score            Float?
  avg_top_score        Float?
  source_titles_json   Json?
  candidate_debug_json Json?
  created_at           DateTime @default(now())

  @@index([village_id, created_at])
  @@index([retrieval_mode, created_at])
  @@index([confidence, created_at])
  @@index([channel, created_at])
}

// ==================== DURABLE MEMORY OBSERVABILITY ====================
// Stores memory retrieval traces for summary-builder and explicit user memory lookups.

model ai_memory_traces {
  id                    String   @id @default(cuid())
  trace_id              String?
  wa_user_id            String
  village_id            String?
  channel               String?
  source                String
  query                 String   @db.Text
  result_count          Int      @default(0)
  top_score             Float?
  avg_score             Float?
  selected_memories_json Json?
  summary_text          String?  @db.Text
  created_at            DateTime @default(now())

  @@index([wa_user_id, created_at])
  @@index([village_id, created_at])
  @@index([source, created_at])
  @@index([channel, created_at])
}

// ==================== DURABLE GUARDRAIL EVENTS ====================
// Makes deterministic outer guards observable for admin dashboards and exports.

model ai_guardrail_events {
  id                String   @id @default(cuid())
  trace_id          String?
  wa_user_id        String?
  village_id        String?
  channel           String?
  guard_stage       String
  guard_type        String
  action            String
  reason            String?
  message_preview   String?  @db.Text
  metadata_json     Json?
  created_at        DateTime @default(now())

  @@index([guard_type, created_at])
  @@index([guard_stage, created_at])
  @@index([village_id, created_at])
  @@index([channel, created_at])
}

// ==================== DURABLE TOOL POLICY TUNING ====================
// Stores eval-driven/runtime-derived allowlist policies and their runtime events.

model ai_tool_allowlist_policies {
  id                String   @id @default(cuid())
  policy_key        String   @unique
  source            String
  match_terms_json  Json
  allowed_tools_json Json
  confidence        Float    @default(0.5)
  evaluation_count  Int      @default(0)
  success_count     Int      @default(0)
  last_seen_at      DateTime @default(now())
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([source, updated_at])
  @@index([confidence, updated_at])
}

model ai_tool_policy_events {
  id                   String   @id @default(cuid())
  trace_id             String?
  wa_user_id           String?
  village_id           String?
  channel              String?
  query                String   @db.Text
  policy_key           String?
  policy_source        String?
  heuristic_tools_json Json?
  learned_tools_json   Json?
  allowed_tools_json   Json?
  actual_tools_json    Json?
  success              Boolean  @default(true)
  created_at           DateTime @default(now())

  @@index([policy_key, created_at])
  @@index([village_id, created_at])
  @@index([channel, created_at])
}
