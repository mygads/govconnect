# ===================================================================================
# GOVCONNECT - ENVIRONMENT CONFIGURATION
# ===================================================================================
#
# Runtime docker-compose reads `.env` via env_file. Production deployment copies
# `.env.production` to the server as `.env`; `.env.example` keeps the same keys
# with placeholder values.
#
# Do not set a global DATABASE_URL or PORT here: docker-compose injects the
# correct per-service DATABASE_URL, and each service has its own default port.
# ===================================================================================

# ==================== ENVIRONMENT ====================
NODE_ENV=production
LOG_LEVEL=info
DASHBOARD_PORT=3011

# ==================== DOCKER IMAGES ====================
# Local can use compose defaults/local tags; production should use GHCR images.
IMAGE_CHANNEL=ghcr.io/owner/govconnect-channel-service:latest
IMAGE_AI=ghcr.io/owner/govconnect-ai-service:latest
IMAGE_CASE=ghcr.io/owner/govconnect-case-service:latest
IMAGE_NOTIFICATION=ghcr.io/owner/govconnect-notification-service:latest
IMAGE_DASHBOARD=ghcr.io/owner/govconnect-dashboard:latest

# ==================== DATABASE (PostgreSQL) ====================
# Compose injects each value into the matching service as DATABASE_URL.
DATABASE_URL_CHANNEL=postgresql://user:password@infra-postgres:5432/govconnect?schema=channel
DATABASE_URL_AI=postgresql://user:password@infra-postgres:5432/govconnect?schema=ai
DATABASE_URL_CASE=postgresql://user:password@infra-postgres:5432/govconnect?schema=cases
DATABASE_URL_NOTIFICATION=postgresql://user:password@infra-postgres:5432/govconnect?schema=notification
DATABASE_URL_DASHBOARD=postgresql://user:password@infra-postgres:5432/govconnect?schema=dashboard

# ==================== RABBITMQ ====================
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=genfityrabbitmq
RABBITMQ_URL=amqp://admin:genfityrabbitmq@rabbitmq:5672/govconnect
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672

# ==================== SERVICE URLS (internal Docker network) ====================
CHANNEL_SERVICE_URL=http://channel-service:3001
AI_SERVICE_URL=http://ai-service:3002
CASE_SERVICE_URL=http://case-service:3003
NOTIFICATION_SERVICE_URL=http://notification-service:3004
DASHBOARD_SERVICE_URL=http://dashboard:3000

# ==================== SECURITY ====================
# Generate secrets with: openssl rand -base64 32
# Encryption keys should be 64-char hex for AES-256-GCM.
INTERNAL_API_KEY=change-me-internal-api-keys
JWT_SECRET=change-me-jwt-secret
PROFILE_ENCRYPTION_KEY=change-me-32-byte-hex-key
AI_PROVIDER_ENCRYPTION_KEY=
SERVICE_AUTH_SECRET=
SIGNED_URL_SECRET=
SIGNED_URL_TTL=3600
WEBHOOK_ALLOWED_IPS=
WEBHOOK_HMAC_REQUIRED=false
ALLOWED_ORIGINS=http://localhost:3011,http://127.0.0.1:3011,http://localhost:3000,http://127.0.0.1:3000

# ==================== WHATSAPP API ====================
WA_API_URL=https://wa.example.com/v1/wa
WA_WEBHOOK_VERIFY_TOKEN=
WA_SUPPORT_URL=https://wa.example.com
WA_SUPPORT_INTERNAL_API_KEY=change-me-wa-support-api-key
WA_DRY_RUN=false

# ==================== TESTING MODE ====================
TESTING_MODE=false

# ==================== AI GATEWAY LANES ====================
# govconnect-ai-service reads these as runtime lane fallback/config.
# Provider/model records can also be managed in the AI service database.
LLM_PROVIDER=openrouter
LLM_API_KEY=change-me-llm-api-key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=inclusionai/ling-2.6-flash:free
LLM_TIMEOUT_MS=30000
LLM_CHAT_COMPLETIONS_PATH=/chat/completions
EMBED_PROVIDER=openrouter
EMBED_API_KEY=change-me-embed-api-key
EMBED_BASE_URL=https://openrouter.ai/api/v1
EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
EMBED_DIMENSIONS=768
EMBED_TIMEOUT_MS=30000
EMBED_EMBEDDINGS_PATH=/embeddings
RAG_PROVIDER=openrouter
RAG_API_KEY=change-me-rag-api-key
RAG_BASE_URL=https://openrouter.ai/api/v1
RAG_REWRITE_MODEL=inclusionai/ling-2.6-flash:free
RAG_QUERY_REWRITE_TIMEOUT_MS=10000
RAG_CHAT_COMPLETIONS_PATH=/chat/completions
RAG_RETRIEVAL_MODE=heuristic_rerank
RERANK_PROVIDER=openrouter
RERANK_API_KEY=change-me-rerank-api-key
RERANK_BASE_URL=https://openrouter.ai/api/v1
RERANK_MODEL=inclusionai/ling-2.6-flash:free
RERANK_ENABLED=true
RERANK_TIMEOUT_MS=30000
RERANK_PATH=/chat/completions
RERANK_TOP_N=5
LLM_DEFAULT_HEADERS_JSON=
EMBED_DEFAULT_HEADERS_JSON=
RAG_DEFAULT_HEADERS_JSON=
RERANK_DEFAULT_HEADERS_JSON=
OPENROUTER_SITE_URL=https://genfity.com
OPENROUTER_APP_NAME=Genfity Digital Solutions
OPENROUTER_PROVIDER_ORDER=
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_REQUIRE_PARAMETERS=false
OPENROUTER_ZDR_ONLY=false
RAG_LLM_RERANK_MAX_CANDIDATES=12
RAG_ENABLE_RETRIEVAL_CACHE=true
RAG_RETRIEVAL_CACHE_TTL_SECONDS=300
EMBEDDING_RETRY_COUNT=3
EMBEDDING_RETRY_BASE_MS=500
EMBEDDING_RETRY_MAX_MS=5000
BATCH_DELAY_MS=3000
WEBCHAT_BATCH_DELAY_MS=3000
MAX_BATCH_SIZE=5
GOLDEN_SET_THRESHOLD_TOOL=0.70
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=3000
MAX_HISTORY_MESSAGES=30
AI_MODEL_PRICING_OVERRIDES=

# ==================== SPAM GUARD ====================
SPAM_GUARD_ENABLED=true
SPAM_GUARD_MAX_IDENTICAL=5
SPAM_GUARD_BAN_DURATION_MS=60000
SPAM_RATE_MAX_MESSAGES=10
SPAM_RATE_WINDOW_MS=10000

# ==================== RATE LIMITING ====================
RATE_LIMIT_ENABLED=true
MAX_REPORTS_PER_DAY=5
COOLDOWN_SECONDS=30
AUTO_BLACKLIST_VIOLATIONS=10

# ==================== S3 / OBJECT STORAGE ====================
# Used by Channel Service and AI Service for uploads/documents.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_PATH_STYLE=false
S3_PUBLIC_URL=https://cdn.example.com
S3_RETENTION_DAYS=365
S3_MEDIA_DELIVERY=s3

# ==================== PUBLIC URLS ====================
DASHBOARD_URL=https://app.example.com
PUBLIC_BASE_URL=https://app.example.com
PUBLIC_CHANNEL_BASE_URL=https://channel.example.com
PUBLIC_FORM_BASE_URL=https://forms.example.com

# ==================== CASE SERVICE ====================
ID_PREFIX_COMPLAINT=LAP
ID_PREFIX_SERVICE_REQUEST=LAY

# ==================== NOTIFICATION SERVICE ====================
ENABLE_URGENT_WA_ALERT=false
ADMIN_WHATSAPP=

# ==================== LOGGING ====================
LOG_DIR=logs

# ==================== SEO & ANALYTICS ====================
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_VERIFICATION=your-google-site-verification
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=
NEXT_PUBLIC_PINTEREST_VERIFICATION=
NEXT_PUBLIC_YAHOO_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# ==================== OPTIONAL SEED / SCRIPT VARIABLES ====================
# Used by seed/test/maintenance scripts; leave blank unless running those scripts.
SUPERADMIN_NAME=
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
SANGRESENG_ADMIN_NAME=
SANGRESENG_ADMIN_USERNAME=
SANGRESENG_ADMIN_PASSWORD=
AI_SEED_WALLET_USD=
SEED_VILLAGE_ID=
SEED_SANRESENG_ADE=
VILLAGE_ID=
AI_TEST_VILLAGE_ID=
API_BASE_URL=
KB_ID=
KB_FILE=
TARGET_FILE=
MESSAGE_BATCH_PUBLISH_RETRY_DELAY_MS=1000
GOLDEN_SET_BATCH_SIZE=25
GOLDEN_SET_THRESHOLD_INTENT=0.70
GOLDEN_SET_THRESHOLD_KEYWORD=0.70
GOLDEN_SET_THRESHOLD_OVERALL=0.70
GOLDEN_SET_REGRESSION_DELTA=0.05
