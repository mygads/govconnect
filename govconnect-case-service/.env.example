# ==================== CASE SERVICE ====================
#
# ENVIRONMENT MODES:
# ┌──────────────────────────────────────────────────────────────────────────┐
# │  MODE              │ SERVICE_URL PATTERN         │ DATABASE HOST         │
# ├──────────────────────────────────────────────────────────────────────────┤
# │  Local Dev (npm)   │ http://localhost:PORT       │ localhost:5432        │
# │  Docker Compose    │ http://service-name:PORT    │ postgres:5432         │
# │  Docker Swarm      │ http://service-name:PORT    │ postgres:5432         │
# └──────────────────────────────────────────────────────────────────────────┘
#
# This service handles:
# - Complaint (Laporan) CRUD
# - Service Request (Permohonan Layanan) CRUD
# - Statistics API
# - Publish events to RabbitMQ
# ============================================================================

# Environment
NODE_ENV=development
PORT=3003

# Database (Case Service)
# Local Dev: localhost:5432
# Docker: infra-postgres:5432
DATABASE_URL=postgresql://user:password@infra-postgres:5432/govconnect?schema=cases

# RabbitMQ
# Local Dev: localhost:5672
# Docker: rabbitmq:5672
RABBITMQ_URL=amqp://admin:genfityrabbitmq@rabbitmq:5672/govconnect

# Internal API Key (shared secret for inter-service authentication)
INTERNAL_API_KEY=govconnect-internal-2025-secret

# Logging
LOG_LEVEL=debug
LOG_DIR=logs

# ID Generation
ID_PREFIX_COMPLAINT=LAP
ID_PREFIX_SERVICE_REQUEST=LAY

# AI Service (gateway-only complaint type resolution)
# Case Service delegates semantic complaint type matching to AI Service.
AI_SERVICE_URL=http://ai-service:3002
